# Runtime-конфигурация AI. Не публикуйте реальные ключи.
OPENAI_API_KEY=
OPENAI_MODEL=
# false отключает AI; без ключа/модели доступно сравнение текста с предупреждением.
ORGTRACE_AI=true
# Необязательно; модель embeddings по умолчанию.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# true — синтетический браузерный пример; false — реальный API.
# После изменения перезапустите dev / пересоберите production.
NEXT_PUBLIC_USE_MOCK=false
