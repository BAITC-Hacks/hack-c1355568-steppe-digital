# The scaffold parses documents without making AI calls.
# Configure these locally before enabling future AI stages.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional; defaults to text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Public frontend mode flag: true uses synthetic browser demo data.
# Restart dev / rebuild production after changing it. False uses the real API.
NEXT_PUBLIC_USE_MOCK=false
